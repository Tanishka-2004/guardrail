# GuardRail Environment Configuration Example

# General
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=true

# PostgreSQL
POSTGRES_USER=guardrail
POSTGRES_PASSWORD=guardrail_secret_pass
POSTGRES_DB=guardrail_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://guardrail:guardrail_secret_pass@localhost:5432/guardrail_db
SYNC_DATABASE_URL=postgresql://guardrail:guardrail_secret_pass@localhost:5432/guardrail_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=guardrail_redis_pass
REDIS_URL=redis://:guardrail_redis_pass@localhost:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
KAFKA_TOPIC_ALERTS=fraud.alerts
KAFKA_TOPIC_RETRY=fraud.alerts.retry
KAFKA_TOPIC_DLQ=fraud.alerts.dlq
KAFKA_TOPIC_EVENTS=fraud.alerts.events
KAFKA_CONSUMER_GROUP=guardrail-alert-consumer-group

# Security & JWT
JWT_SECRET_KEY=guardrail-super-secure-production-jwt-secret-key-32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Claim Lease (in seconds)
CLAIM_LEASE_DURATION_SECONDS=600

# Scoring & Circuit Breaker
SCORING_FAILURE_THRESHOLD=5
SCORING_RECOVERY_TIMEOUT_SECONDS=30
SCORING_REQUEST_TIMEOUT_SECONDS=3.0

# Feature Flags
ENABLE_KAFKA_CONSUMER=true
ENABLE_BACKGROUND_WORKERS=true
